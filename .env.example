# =============================================================================
# AIPM 学习工作台 · 环境变量示例
# -----------------------------------------------------------------------------
# 用法：
#   本地开发 —— 复制成 .env 后按需改（本项目不自动读 .env，
#               请用 `$env:X="..."` 方式设置，见 README《本地启动》）
#   托管平台 —— 这些键值填到平台的环境变量面板里，不要提交真实密钥
#
# 只有 DEEPSEEK_API_KEY 是必填，其余都有合理默认值。
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# 必填
# ─────────────────────────────────────────────────────────────────────────────

# DeepSeek API 密钥。去 https://platform.deepseek.com 创建。
# 格式形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ⚠️ 只存在后端环境变量里，前端任何接口都不会回传它。
DEEPSEEK_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# 服务
# ─────────────────────────────────────────────────────────────────────────────

# 监听端口。托管平台一般会自动注入 PORT，不用手填。
# 本地默认 3000。
PORT=3000

# 监听地址。本地开发留 127.0.0.1（仅本机可访问）；
# 部署到容器/托管平台必须设 0.0.0.0，否则平台探针访问不到，
# 会出现"部署显示成功但链接打不开"。
HOST=0.0.0.0

# 运行环境。production 时 npm install 不装开发依赖。
NODE_ENV=production

# 可选：设置后启动日志里会显示这个公网地址，方便核对
# PUBLIC_URL=https://your-app.onrender.com


# ─────────────────────────────────────────────────────────────────────────────
# 大模型
# ─────────────────────────────────────────────────────────────────────────────

# 对话模型。deepseek-chat 性价比高，日常问答够用。
DEEPSEEK_MODEL=deepseek-chat

# API 基址。走官方；若用第三方中转，改成对应地址。
DEEPSEEK_BASE=https://api.deepseek.com


# ─────────────────────────────────────────────────────────────────────────────
# 本地向量检索
# ─────────────────────────────────────────────────────────────────────────────

# 是否用镜像内的 bge-base-zh-v1.5 真实编码查询语句。
#   1 = 质量最好（实测 top1 命中 16/20），启动时加载约 100MB 模型，需约 250MB 内存
#   0 = 退回"关键词近似向量"（省内存、启动快，但 top1 命中降到 12/20）
# 建议：内存 ≥512MB 就设 1。
ENABLE_QUERY_MODEL=1

# 强制离线：模型权重已随镜像打包，运行时不允许再去 HuggingFace 下载。
# 托管平台出网受限或不稳定时必须设 1，否则启动会卡在下载上。
HF_HUB_OFFLINE=1

# 模型下载镜像（仅在需要重新下载权重时生效）。
# HuggingFace 官方站在国内不可达，默认走这个镜像。
HF_ENDPOINT=https://hf-mirror.com

# 换检索模型（改了必须重跑 build_embeddings.js 重建向量）。
# 默认 bge-base-zh-v1.5：768 维、中文检索专用、实测最优。
EMBED_MODEL=Xenova/bge-base-zh-v1.5


# ─────────────────────────────────────────────────────────────────────────────
# 可选：联网搜索
# ─────────────────────────────────────────────────────────────────────────────
# 不配置时，问答只用本地知识库 + 大模型自身知识，功能不受影响。
# 配置后，时效性问题（价格/版本/政策）会自动联网补充。

# 搜索服务商，目前支持 bocha（博查）。去 https://open.bochaai.com 申请。
# SEARCH_PROVIDER=bocha

# 搜索 API 密钥。在平台环境变量里设置后，网页端设置面板将只读不可改。
# SEARCH_API_KEY=

# 联网策略：
#   auto   = 由系统判断（本地知识库答不好、或问题涉及时效性时才搜）—— 推荐
#   always = 每次提问都联网
#   never  = 从不联网
WEB_MODE=auto

# 设为 0 可关闭"写完笔记自动让 AI 补全"（省额度）。
# AUTO_ENRICH=1
